# Modèle de fichier .env : copier en ".env" (ignoré par git) et adapter. Ne JAMAIS y mettre de jeton.
# Les jetons restent dans des fichiers secrets (SOPS / Vault / secrets Docker) ; ici on ne met que leur CHEMIN.

# Source des logs : loki | push | simule (simule = développement uniquement)
DETECTOR_SOURCE=loki

# Loki (depuis un PC hors Docker : adresse du serveur Loki)
LOKI_URL=http://loki:3100
# Label Loki qui donne le nom du service. Les logs Basecamp portent déjà "service" dans leur JSON
# (basecamp-shop, basecamp-payment, basecamp-auth) : le label ne sert qu'en secours.
LOKI_LABEL_SERVICE=service
# Flux à lire. À AFFINER avec INFRA (label du conteneur/projet) pour ne lire que les services Basecamp :
LOKI_SELECTEUR={job="docker"}
# Motifs de bruit à écarter, séparés par des virgules (vérifications de santé de BunkerWeb) :
LOKI_EXCLURE=bwapi

# Moteur de remédiation (vide = alertes seulement journalisées)
REMEDIATION_URL=http://remediation:8080/alertes
ALERT_TOKEN_FILE=/run/secrets/alert_token

# RAG / LLM (vide = désactivé)
RAG_URL=http://rag:8000/contexte-incident
RAG_TOKEN_FILE=/run/secrets/rag_token

# Mode push uniquement
# INGEST_TOKEN_FILE=/run/secrets/ingest_token

# Réglages facultatifs
# MODEL_PATH=models/detecteur.joblib
# LAG_SECONDS=5
# N_CONSECUTIFS=3
